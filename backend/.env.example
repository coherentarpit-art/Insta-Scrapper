PORT=3001
# Same Atlas + DB as scraper — profile API reads Mongo first, then falls back to ../data/*.json
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGO_DB=coherent2026_db
MONGO_COLLECTION=insta_Profiles

# Live Instagram (GET /api/profile/:username/live) — copy from the same logged-in session as scraper.
# Chrome: DevTools → Network → pick a request to instagram.com → Request Headers:
#   IG_ACC1_COOKIES = full value of the "cookie" header (one line; quote if it has spaces/special chars)
#   IG_ACC1_CSRF    = value of "x-csrftoken" (must match csrftoken= inside the cookie string)
# If you omit IG_ACC1_*, the server falls back to IG_COOKIES + IG_CSRF_TOKEN (same values).
IG_ACC1_COOKIES=
IG_ACC1_CSRF=
# IG_COOKIES=
# IG_CSRF_TOKEN=
# Optional (live fetch only): copy from Chrome request headers if you still see HTTP_400 on /live
# IG_ASBD_ID=359341
# IG_WWW_CLAIM=

# Optional: Instaloader for GET /api/profile/:username/live (pip install instaloader; set PYTHON if needed)
# USE_INSTALOADER=1
# PYTHON=python
# INSTALOADER_SESSION_FILE=
# INSTALOADER_SESSION_USER=
# INSTALOADER_USER=
# INSTALOADER_PASSWORD=
