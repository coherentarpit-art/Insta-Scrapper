PORT=3001
# Same Atlas + DB as scraper — profile API reads Mongo first, then falls back to ../data/*.json
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
MONGO_DB=coherent2026_db
MONGO_COLLECTION=insta_Profiles

# Live Instagram (GET /api/profile/:username/live) — copy from the same logged-in session as scraper.
# Chrome: DevTools → Network → pick a request to instagram.com → Request Headers:
#   IG_ACC1_COOKIES = full value of the "cookie" header (one line; quote if it has spaces/special chars)
#   IG_ACC1_CSRF    = value of "x-csrftoken" (must match csrftoken= inside the cookie string)
# If you omit IG_ACC1_*, the server falls back to IG_COOKIES + IG_CSRF_TOKEN (same values).
# Put real values in backend/.env (gitignored). When Instagram rotates cookies, paste the new
# "cookie" + "x-csrftoken" from DevTools again and restart the API.
IG_ACC1_COOKIES=
IG_ACC1_CSRF=
# IG_COOKIES=
# IG_CSRF_TOKEN=
# Optional (live fetch): copy from the same instagram.com request as the cookie
# IG_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ...
# IG_LSD=...                    # x-fb-lsd from Network — often required for /api/v1/... JSON
# IG_ASBD_ID=359341
# IG_WWW_CLAIM=

# Optional: Instaloader for "Refresh live" (Instaloader only / Auto) — set on backend OR in scraper/.env (both are loaded)
# USE_INSTALOADER=1
# PYTHON=python
# Same session as: python -m instaloader --login YOUR_USER  (file like session-YOUR_USER)
# INSTALOADER_SESSION_FILE=C:\Users\You\AppData\Local\Instaloader\session-YOUR_USER
# INSTALOADER_SESSION_USER=YOUR_USER
# INSTALOADER_USER=
# INSTALOADER_PASSWORD=
# If Instaloader logs "session check failed" but login is valid, try: INSTALOADER_SKIP_TEST_LOGIN=1
