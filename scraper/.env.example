# ─── OPTIONAL: Instaloader (Python) — real-time profile + posts, bypasses browser cookies ───
# Install: pip install -r requirements-instaloader.txt
# USE_INSTALOADER=1
# PYTHON=python
# (Windows Store Python: use "python"; Linux/Mac often "python3")
# INSTALOADER_TIMEOUT_MS=120000
# Session file from: instaloader --login YOUR_USER  (creates session under ~/.config/instaloader/)
# INSTALOADER_SESSION_FILE=C:\Users\you\.config\instaloader\session-YOUR_USER
# INSTALOADER_SESSION_USER=YOUR_USER
# Or password login (less ideal):
# INSTALOADER_USER=YOUR_USER
# INSTALOADER_PASSWORD=your_app_password
