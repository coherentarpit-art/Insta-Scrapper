# ============================================================
#  INSTASCRAPER — .env configuration
#  Copy this file to scraper/.env and fill in your values.
#  DO NOT commit .env to git.
# ============================================================

# ─── MONGODB ────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_DB=coherent2026_db
MONGO_COLLECTION=insta_Profiles
# Optional: queue-crawler also upserts every saved profile here (same shape as MONGO_COLLECTION).
# MONGO_COLLECTION_NEW=NewInstaProfile

# ─── REDIS ──────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword    # uncomment if Redis has a password

# ─── SCRAPER SETTINGS ───────────────────────────────────────
QUOTA_PER_CATEGORY=4000          # profiles to scrape per category (26 cats × 4000 = 104k)
REFRESH_AFTER_DAYS=7             # re-scrape profiles older than this many days

# ─── HOW TO GET CREDENTIALS FOR EACH ACCOUNT ────────────────
#
#  1. Open Chrome → log into Instagram with Account 1
#  2. Press F12 → go to "Network" tab
#  3. Refresh the page (instagram.com)
#  4. Click any request to www.instagram.com in the list
#  5. Scroll to "Request Headers" on the right
#  6. Copy the FULL value of the "cookie" header  → paste as IG_ACC1_COOKIES
#  7. Copy the value of "x-csrftoken" header      → paste as IG_ACC1_CSRF
#  8. Repeat for each account (log out, log in with next account)
#
#  The cookie string looks like:
#    csrftoken=abc123; datr=xxx; ig_did=xxx; sessionid=123456%3Axxx; ...
#
#  The csrftoken value (IG_ACC1_CSRF) is the same as the csrftoken= part
#  in the cookie string (just the value after "csrftoken=", before the ";")
# ────────────────────────────────────────────────────────────

# ─── ACCOUNT 1 ──────────────────────────────────────────────
IG_ACC1_COOKIES=csrftoken=REPLACE_ME; datr=REPLACE_ME; ig_did=REPLACE_ME; sessionid=REPLACE_ME; ds_user_id=REPLACE_ME
IG_ACC1_CSRF=REPLACE_ME
# IG_ACC1_APPID=936619743392459   # optional, default is fine

# ─── ACCOUNT 2 ──────────────────────────────────────────────
IG_ACC2_COOKIES=csrftoken=REPLACE_ME; datr=REPLACE_ME; ig_did=REPLACE_ME; sessionid=REPLACE_ME; ds_user_id=REPLACE_ME
IG_ACC2_CSRF=REPLACE_ME

# ─── ACCOUNT 3 ──────────────────────────────────────────────
IG_ACC3_COOKIES=csrftoken=REPLACE_ME; datr=REPLACE_ME; ig_did=REPLACE_ME; sessionid=REPLACE_ME; ds_user_id=REPLACE_ME
IG_ACC3_CSRF=REPLACE_ME

# ─── ACCOUNT 4 ──────────────────────────────────────────────
IG_ACC4_COOKIES=csrftoken=REPLACE_ME; datr=REPLACE_ME; ig_did=REPLACE_ME; sessionid=REPLACE_ME; ds_user_id=REPLACE_ME
IG_ACC4_CSRF=REPLACE_ME

